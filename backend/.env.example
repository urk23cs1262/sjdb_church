# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Canonical Public Website Base URL (For production review links in WhatsApp, Email & Push)
PUBLIC_FRONTEND_BASE_URL=https://example.com

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/sjdb_church
MONGO_URI=mongodb://localhost:27017/sjdb_church

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Church & Administrator Contact Information (No real values in example file)
CHURCH_EMAIL=parish.office@example.com
PARISH_EMAIL=parish.office@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com
EMAIL_FROM=notifications@example.com
EMAIL_REPLY_TO=parish.office@example.com

CHURCH_PHONE=+919876543210
PARISH_OFFICE_PHONE=+919876543211
ADMIN_PHONE=919876543210
ADMIN_PHONES=919876543210,919876543211

# WhatsApp Integration (Baileys)
WHATSAPP_BOT_PHONE_NUMBER=919876543210
WHATSAPP_ADMIN_NUMBER=919876543210
WHATSAPP_SUPPORT_NUMBER=919876543210
WHATSAPP_CHANNEL_JID=120363000000000000@newsletter
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Va0000000000000000

# Razorpay Payment Gateway (Test or Live credentials)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Donation & UPI Payment Configuration
DONATION_UPI_ID=your-church-upi@bank
MERCHANT_NAME=St. John de Britto Church

# SMTP / Email Service (e.g., Brevo, Gmail, Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=notifications@example.com
VAPID_EMAIL=mailto:notifications@example.com

# Twilio (Optional - for SMS / WhatsApp fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=+14155238886
