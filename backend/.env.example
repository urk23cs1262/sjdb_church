# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/sjdb_church
MONGO_URI=mongodb://localhost:27017/sjdb_church

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Razorpay Payment Gateway (Test or Live credentials)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Bot Configuration
WHATSAPP_BOT_PHONE_NUMBER=919XXXXXXXXX

# Donation & UPI Payment Configuration
DONATION_UPI_ID=your-upi-id@bank
MERCHANT_NAME=St. John de Britto's Church

# SMTP / Email Service (e.g., Brevo, Gmail, Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

# Twilio (Optional - for SMS / WhatsApp fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=+14155238886
